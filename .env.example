# 环境变量示例文件
# 复制此文件为 .env.local 用于本地开发，或直接在部署平台设置环境变量

# Sentry错误监控配置（前端）
# 从Sentry控制台获取DSN：https://sentry.io/settings/your-org/projects/your-project/keys/
# 留空则不启用错误上报
VITE_SENTRY_DSN=

# 管理员令牌（用于密码重置等敏感操作，务必改为长随机字符串）
ADMIN_TOKEN=change_me_to_a_long_random_admin_token

# 允许的CORS来源（生产环境强烈建议设置为具体域名，多个域名用英文逗号分隔）
# 例如：ALLOWED_ORIGINS=https://your-domain.com,https://your-custom-domain.com
# 注意：不要在生产环境使用 * ，否则任意网站都可尝试携带凭证调用 API
ALLOWED_ORIGINS=http://localhost:3000
