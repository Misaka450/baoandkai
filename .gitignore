# 依赖目录
node_modules/

# 构建产物（dist/ 同时覆盖 server/dist）
dist/
release/

# 环境变量（保留 *.example 模板文件）
.env
.env.local
.env.*.local
.env.test

# 日志文件
*.log

# 本地运行数据（上传的图片等）
uploads/
# 测试临时上传目录
server/uploads-test/

# 测试覆盖率
coverage/

# TypeScript 缓存
*.tsbuildinfo

# 临时目录
tmp/
temp/

# 编辑器与系统文件
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
.history/
*.sw?
.DS_Store
Thumbs.db

# 临时调试文件
tsc_errors.txt